<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <!-- VNC canvas -->
    <com.virtualpcvm.VncView
        android:id="@+id/vncView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="invisible" />

    <!-- Connecting overlay -->
    <LinearLayout
        android:id="@+id/layoutConnecting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="#B3000000">

        <ProgressBar
            android:id="@+id/progressConnecting"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAlignment="center"
            android:text="Подключение к QEMU VNC..." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryConnect"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:text="Повторить подключение" />
    </LinearLayout>

    <!-- Top Toolbar overlay -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#D9121212"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="← Назад"
            android:textColor="#E0E0E0"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingHorizontal="4dp"
            android:text="Virtual PC" />

        <TextView
            android:id="@+id/tvResourceMonitor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#80D8FF"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:text="CPU: --% RAM: --MB"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSnapshot"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="💾"
            android:textColor="#E0E0E0"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoadSnapshot"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="📂"
            android:textColor="#E0E0E0"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMouseMode"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🖱 Тач"
            android:textColor="#E0E0E0"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleKeyboardBar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="⌨ PC Клв"
            android:textColor="#E0E0E0"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogs"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Логи"
            android:textColor="#E0E0E0"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="🛑 Стоп"
            android:textColor="#FF5252"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp" />

    </LinearLayout>

    <!-- Draggable PC Keyboard Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutPcKeyboardBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:visibility="gone"
        app:cardBackgroundColor="#CC1A1A1A"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="#33FFFFFF">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Drag Handle -->
            <View
                android:id="@+id/keyboardDragHandle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/drag_handle_bg" />

            <!-- Row 1: Functions -->
            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyEsc"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="44dp"
                    android:paddingHorizontal="6dp"
                    android:text="Esc"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyTab"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="44dp"
                    android:paddingHorizontal="6dp"
                    android:text="Tab"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyCtrl"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="48dp"
                    android:paddingHorizontal="6dp"
                    android:text="Ctrl"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyAlt"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="44dp"
                    android:paddingHorizontal="6dp"
                    android:text="Alt"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyShift"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="48dp"
                    android:paddingHorizontal="6dp"
                    android:text="Shift"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyWin"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="44dp"
                    android:paddingHorizontal="6dp"
                    android:text="Win"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyFKeys"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="48dp"
                    android:paddingHorizontal="6dp"
                    android:text="F1-F12"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyCombos"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="56dp"
                    android:paddingHorizontal="6dp"
                    android:text="Ctrl+Alt+Del"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyUp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="38dp"
                    android:paddingHorizontal="4dp"
                    android:text="▲"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyDown"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="38dp"
                    android:paddingHorizontal="4dp"
                    android:text="▼"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyLeft"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="38dp"
                    android:paddingHorizontal="4dp"
                    android:text="◀"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyRight"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="38dp"
                    android:paddingHorizontal="4dp"
                    android:text="▶"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyEnter"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="48dp"
                    android:paddingHorizontal="6dp"
                    android:text="Enter ↵"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyBackspace"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="44dp"
                    android:paddingHorizontal="6dp"
                    android:text="⌫ Del"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keySoftKeyboard"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:minWidth="44dp"
                    android:paddingHorizontal="8dp"
                    android:text="⌨ Ввод"
                    android:textSize="12sp" />

            </LinearLayout>
        </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Logs overlay (hidden by default) -->
    <LinearLayout
        android:id="@+id/layoutLogs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="44dp"
        android:background="#F20D1117"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:background="#21262D">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="Журнал вывода QEMU" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseLogs"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="✕ Закрыть"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">
            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#58A6FF"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:text="Журнал пуст..." />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
