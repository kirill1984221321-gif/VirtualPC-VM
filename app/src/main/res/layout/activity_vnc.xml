<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505">

    <!-- VNC canvas -->
    <com.virtualpcvm.VncView
        android:id="@+id/vncView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="invisible" />

    <!-- Connecting overlay -->
    <LinearLayout
        android:id="@+id/layoutConnecting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@drawable/bg_search">

        <ProgressBar
            android:id="@+id/progressConnecting"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textAlignment="center"
            android:text="Подключение к QEMU VNC..." />

        <!-- Troubleshooting action buttons -->
        <LinearLayout
            android:id="@+id/layoutConnectionActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:gravity="center_horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryConnect"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Повторить подключение" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenExternalVnc"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Открыть в RealVNC / внешнем приложении" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyVncAddress"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Скопировать 127.0.0.1:port" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnectionLogs"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Посмотреть логи QEMU" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Toolbar overlay -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#E6121212"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="←"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingHorizontal="4dp"
            android:text="Virtual PC" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvResourceMonitor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#80D8FF"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:text="CPU: --% RAM: --MB"
                    android:layout_marginHorizontal="6dp" />

                <!-- Zoom Controls -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnZoomIn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🔍+"
                    android:textColor="#E0E0E0"
                    android:minWidth="0dp"
                    android:paddingHorizontal="5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnZoomOut"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🔍-"
                    android:textColor="#E0E0E0"
                    android:minWidth="0dp"
                    android:paddingHorizontal="5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFitScreen"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="⛶ Fit"
                    android:textColor="#80D8FF"
                    android:minWidth="0dp"
                    android:paddingHorizontal="5dp" />

                <!-- Soft keyboard toggle -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSoftKeyboard"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="⌨ IME"
                    android:textColor="#E0E0E0"
                    android:minWidth="0dp"
                    android:paddingHorizontal="5dp" />

                <!-- Touch / Trackpad mouse mode -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMouseMode"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/vnc_touch_mode"
                    android:textColor="#E0E0E0"
                    android:minWidth="0dp"
                    android:paddingHorizontal="5dp" />

                <!-- External VNC Launcher -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExternalVnc"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/vnc_external_button"
                    android:textColor="#80D8FF"
                    android:minWidth="0dp"
                    android:paddingHorizontal="5dp" />

                <!-- Save / Load Snapshots -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveSnapshot"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="💾"
                    android:textColor="#E0E0E0"
                    android:minWidth="0dp"
                    android:paddingHorizontal="5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoadSnapshot"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="📂"
                    android:textColor="#E0E0E0"
                    android:minWidth="0dp"
                    android:paddingHorizontal="5dp" />

                <!-- PC Keyboard Bar Toggle -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleKeyboardBar"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/vnc_pc_keys"
                    android:textColor="#E0E0E0"
                    android:minWidth="0dp"
                    android:paddingHorizontal="5dp" />

                <!-- Logs -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogs"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/btn_logs"
                    android:textColor="#E0E0E0"
                    android:minWidth="0dp"
                    android:paddingHorizontal="5dp" />

                <!-- Stop VM -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStop"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🛑"
                    android:textColor="#FF5252"
                    android:minWidth="0dp"
                    android:paddingHorizontal="5dp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Persistent Collapsed Shortcuts Pill (visible when helper is closed) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnExpandShortcutsPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="44dp"
        app:cardBackgroundColor="#D91E242B"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:strokeWidth="1dp"
        app:strokeColor="#55FFFFFF"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌨"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sc_helper_expand"
                android:textColor="#E0E6ED"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ▴"
                android:textColor="#80D8FF"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Persistent Collapsible Shortcuts & Controls Helper Overlay -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutShortcutsHelper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="44dp"
        android:visibility="gone"
        app:cardBackgroundColor="#E6161B22"
        app:cardCornerRadius="16dp"
        app:cardElevation="10dp"
        app:strokeWidth="1dp"
        app:strokeColor="#44FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Drag & Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌨"
                    android:textSize="16sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sc_helper_title"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Capture Mode Toggle in Helper -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHelperMouseMode"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="@string/vnc_touch_mode"
                    android:textSize="11sp"
                    android:paddingHorizontal="8dp"
                    android:layout_marginEnd="6dp" />

                <!-- Collapse button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCollapseShortcuts"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="✕"
                    android:textColor="#8892B0"
                    android:textSize="14sp"
                    android:minWidth="32dp"
                    android:paddingHorizontal="4dp" />
            </LinearLayout>

            <!-- Mode Explanation & Gestures Guide -->
            <TextView
                android:id="@+id/tvGesturesGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#80D8FF"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sc_mode_touch_desc"
                android:layout_marginBottom="8dp" />

            <!-- Row 1: Quick Common Emulator Commands -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShortcutCad"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Ctrl+Alt+Del"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShortcutAltTab"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Alt+Tab"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShortcutAltF4"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Alt+F4"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShortcutWin"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Win ❖"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShortcutCtrlEsc"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Ctrl+Esc"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShortcutCopy"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Ctrl+C"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShortcutPaste"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Ctrl+V"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:layout_marginEnd="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShortcutF11"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="F11 (Full)"
                        android:textSize="11sp"
                        android:paddingHorizontal="8dp"
                        android:layout_marginEnd="4dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Row 2: Standard Keyboard Controls -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyEsc"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="42dp"
                        android:paddingHorizontal="4dp"
                        android:text="Esc"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyTab"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="42dp"
                        android:paddingHorizontal="4dp"
                        android:text="Tab"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyCtrl"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="46dp"
                        android:paddingHorizontal="4dp"
                        android:text="Ctrl"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyAlt"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="42dp"
                        android:paddingHorizontal="4dp"
                        android:text="Alt"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyShift"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="46dp"
                        android:paddingHorizontal="4dp"
                        android:text="Shift"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyFKeys"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="46dp"
                        android:paddingHorizontal="4dp"
                        android:text="F1-F12"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyUp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="2dp"
                        android:minWidth="34dp"
                        android:paddingHorizontal="2dp"
                        android:text="▲"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyDown"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="2dp"
                        android:minWidth="34dp"
                        android:paddingHorizontal="2dp"
                        android:text="▼"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyLeft"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="2dp"
                        android:minWidth="34dp"
                        android:paddingHorizontal="2dp"
                        android:text="◀"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyRight"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="34dp"
                        android:paddingHorizontal="2dp"
                        android:text="▶"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyEnter"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="46dp"
                        android:paddingHorizontal="4dp"
                        android:text="↵ Enter"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keyBackspace"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="3dp"
                        android:minWidth="42dp"
                        android:paddingHorizontal="4dp"
                        android:text="⌫"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/keySoftKeyboard"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:minWidth="44dp"
                        android:paddingHorizontal="6dp"
                        android:text="⌨ IME"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Logs overlay (hidden by default) -->
    <LinearLayout
        android:id="@+id/layoutLogs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="44dp"
        android:background="#F20D1117"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:background="#21262D">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="Журнал вывода QEMU" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseLogs"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="✕ Закрыть"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">
            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#58A6FF"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:text="Журнал пуст..." />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
