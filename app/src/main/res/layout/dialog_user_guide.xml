<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖"
                android:textSize="26sp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGuideTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_guide"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tvGuideSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Руководство по настройке и использованию Virtual PC"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 1: Quick Start -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvGuideSec1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚀 1. Быстрый старт (Quick Start)"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvGuideSec1Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingExtra="3dp"
                    android:text="• Нажмите кнопку «+ Создать ВМ» на главном экране.\n• Выберите готовый шаблон (например, Windows XP, Windows 7, Alpine Linux) или настройте параметры вручную.\n• Укажите размер диска (qcow2) и образ ISO.\n• Запустите виртуальную машину кнопкой «Старт» и перейдите в экран VNC." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 2: Hardware & Sliders -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvGuideSec2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙ 2. Аппаратные параметры (Hardware)"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvGuideSec2Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingExtra="3dp"
                    android:text="• Слайдер памяти (RAM): регулируйте выделенный объем ОЗУ. Для Windows XP достаточно 512-1024 МБ, для Windows 7/10 рекомендуется 2048-4096 МБ.\n• Слайдер ядер (CPU): 1-8 ядер с поддержкой MTTCG для многопоточности.\n• Сетевые адаптеры: rtl8139 (универсальный для Windows XP), virtio-net-pci (максимальная скорость для Linux), e1000 (Intel Gigabit для Win 7/10).\n• Устройства ввода: USB Tablet обеспечивает точное попадание курсора на сенсорных экранах без рассинхронизации." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 3: Mouse & Touch Modes -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvGuideSec3Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖱 3. Управление мышью (Mouse Modes)"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvGuideSec3Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingExtra="3dp"
                    android:text="• Режим сенсора (Touch Mode): кликает ровно в место касания пальцем. Одиночный тап = ЛКМ, долгое удержание = контекстное меню (ПКМ), двойной тап двумя пальцами = СКМ.\n• Режим трекпада (Trackpad Mode): экран работает как тачпад ноутбука с физическим стрелочным курсором. Ведите пальцем для перемещения курсора, скролльте двумя пальцами вверх/вниз для прокрутки колесика мыши." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 4: Keyboard Shortcuts Helper -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvGuideSec4Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌨ 4. Панель горячих клавиш (Shortcuts Helper)"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvGuideSec4Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingExtra="3dp"
                    android:text="• На экране VNC внизу расположена плавающая кнопка «⌨ Горячие клавиши».\n• Нажмите на неё, чтобы развернуть быструю панель команд: Ctrl+Alt+Del, Alt+Tab, Alt+F4, Win, Ctrl+Esc, копирование/вставка и функциональные клавиши F1-F12.\n• Для ввода текстовых символов нажмите «⌨ IME», чтобы вызвать стандартную экранную клавиатуру телефона." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 5: Snapshots & Backups -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvGuideSec5Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📸 5. Снапшоты и сохранение (Snapshots)"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvGuideSec5Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingExtra="3dp"
                    android:text="• Снапшоты позволяют создавать снимки виртуального диска (qcow2) и состояния памяти.\n• Откройте меню карточки ВМ «Снапшоты» или нажмите иконку дискеты в VNC.\n• Вы можете создать именованную точку (например, «до_установки_программ») и в любой момент откатиться назад кнопкой «Откатить»." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section 6: Real-time System Monitor -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvGuideSec6Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 6. Мониторинг QEMU (System Monitor)"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvGuideSec6Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingExtra="3dp"
                    android:text="• В меню или на карточке работающей машины нажмите «Мониторинг системы».\n• Откроется интерактивный оверлей с живым графиком загрузки CPU и памяти RAM, PID процесса и количеством активных потоков." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
