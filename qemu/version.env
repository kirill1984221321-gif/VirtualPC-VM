# Reproducible upstream QEMU source version for the first Android build.
QEMU_VERSION=11.0.3
QEMU_ARCHIVE=qemu-11.0.3.tar.xz
QEMU_URL=https://download.qemu.org/qemu-11.0.3.tar.xz
QEMU_SHA256=da5fcffc32762820568b828ed430a728864d34d50b6d2f30358597760cbb0523

# Android NDK / ABI used by the first native target.
ANDROID_NDK_VERSION=27.2.12479018
ANDROID_API=24
ANDROID_ABI=arm64-v8a
ANDROID_TRIPLE=aarch64-linux-android

# QEMU guest target built by this pipeline.
QEMU_TARGET_LIST=x86_64-softmmu
QEMU_BINARY=qemu-system-x86_64
